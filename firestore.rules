rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@atc.com.bd' ||
        request.auth.token.email == 'admin.hr@atcl-bd.com' ||
        request.auth.token.email == 'hmekram@gmail.com' ||
        request.auth.token.email == 'atc@dhaka.net'
      );
    }

    function isOwnerByUid(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 1. Users collection (handles login info, OTPs, mustChangePassword)
    match /users/{userId} {
      allow read, write: if isAdmin() || isOwnerByUid(userId);
    }

    // 2. Dashboards / Templates
    match /dashboards/{employeeCode} {
      allow read, write: if isAdmin() || isOwnerByUid(employeeCode);
    }

    match /templates/{templateId} {
      allow read, write: if isAdmin() || (resource != null && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
    }

    // 3. Official Employee profile records
    match /employees/{employeeCode} {
      allow read: if isAdmin() || (resource != null && resource.data.emailAddress == request.auth.token.email);
      allow write: if isAdmin();
    }

    // 4. Leave applications
    match /leaveRequests/{requestId} {
      allow read: if isAdmin() || (resource != null && resource.data.employeeCode == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (resource != null && resource.data.employeeCode == request.auth.uid && resource.data.status == 'Pending');
    }

    // 5. Attendance logs
    match /attendance/{logId} {
      allow read: if isAdmin() || (resource != null && resource.data.employeeCode == request.auth.uid);
      allow create, update: if isAdmin() || isOwnerByUid(request.resource.data.employeeCode);
    }

    // 6. Companies collection (shared corporate info)
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 7. General admin fallback
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
